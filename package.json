{
  "name": "design-studio-starter",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#studio/*": "./src/platform/api/*.ts"
  },
  "scripts": {
    "dev": "pnpm studio sync && node src/platform/node/build/build-manifest.js && vite",
    "build": "node src/platform/node/build/build-manifest.js --strict --deploy && node src/platform/node/check/check-modules.js && pnpm typecheck && vite build",
    "typecheck": "node src/platform/node/check/typecheck.js",
    "preview": "vite preview",
    "new": "node src/platform/modules/prototypes/node/create.js",
    "join": "node src/platform/node/cli/setup-contributor.js",
    "component-docs": "node src/platform/modules/systems/node/scaffold-docs.js",
    "prepare-shadcn": "node src/platform/modules/systems/node/prepare-shadcn.js",
    "prepare": "husky",
    "check": "node src/platform/node/check/check-modules.js",
    "contract": "node src/platform/node/check/check-contract.js",
    "ownership": "node src/platform/node/check/check-ownership.js",
    "baseline": "node src/platform/node/cli/baseline.js",
    "studio": "node src/platform/node/cli/studio.js",
    "canvas": "node src/platform/modules/canvas/cli.ts",
    "test": "node src/platform/node/check/test.js",
    "test:release": "node src/platform/node/check/test.js --release",
    "build:release": "pnpm test:release && pnpm build",
    "build:inspect": "node src/platform/node/check/inspect-build.js",
    "test:changed": "node src/platform/node/check/test.js --changed",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^3.0.0",
    "@base-ui/react": "^1.8.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@excalidraw/excalidraw": "0.18.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/comic-neue": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.4",
    "@lezer/markdown": "^1.7.2",
    "@mdx-js/react": "^3.1.1",
    "@tanstack/react-router": "^1.170.40",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "codemirror-lang-mermaid": "^0.5.0",
    "lucide-react": "^1.48.0",
    "mermaid": "11.17.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "husky": "^9.1.7",
    "postcss": "8.5.28",
    "postcss-selector-parser": "7.1.6",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "semver": "7.8.5",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  }
}
