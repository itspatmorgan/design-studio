{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* Prototype views may be plain .jsx: allowed, but not type-checked */
    "allowJs": true,
    "checkJs": false,

    /* shadcn/ui import alias */
    "paths": { "@/*": ["./src/*"], "@module/*": ["./src/platform/modules/*/lib/index", "./src/modules/*/lib/index"] }
  },
  "include": ["src"],
  "exclude": [
    "src/platform/modules/canvas/liveViews.test.ts",
    "src/platform/modules/canvas/opening.test.ts",
    "src/platform/core/artifact-lifecycle/compiled.test.ts",
    "src/platform/core/artifact-lifecycle/state.test.ts",
    "src/platform/modules/view/preview/protocol.test.ts",
    "src/platform/core/fileTypes.test.ts",
    "src/platform/core/resourceReferences.test.ts",
    "src/platform/core/resourceIdentity.test.ts",
    "src/platform/modules/view/identity.test.ts",
    "src/platform/modules/onboarding/progress.test.ts",
    "src/platform/app/data/prototypeUsage.test.ts",
    "src/platform/node/build",
    "src/platform/node/check",
    "src/platform/node/cli",
    "src/platform/node/eval",
    "src/platform/node/lib",
    "src/platform/node/templates/module",
    "src/platform/node/templates/system",
    "src/platform/modules/*/server.ts",
    "src/modules/*/server.ts",
    "src/platform/modules/canvas/cli.ts",
    "src/platform/modules/canvas/tools.test.ts",
    "src/platform/modules/view/lofi.test.ts",
    "src/platform/modules/systems/content/content.test.ts",
    "src/platform/modules/systems/docs.test.ts",
    "src/platform/core/archive.test.ts",
    "src/platform/core/order.test.ts",
    "src/platform/core/modules/modules.test.ts",
    "src/platform/core/modules/globs.test.ts",
    "src/platform/core/permissions.test.ts",
    "src/platform/core/roots.test.ts",
    "src/platform/core/config.test.ts",
    "src/platform/core/config-file.test.ts",
    "src/platform/modules/systems/spec.test.ts",
    "src/platform/core/modules/pack.test.ts"
  ]
}
