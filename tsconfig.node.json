{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "allowJs": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/platform/core/resourceReferences.test.ts",
    "vite.config.ts",
    "src/modules/*/server.ts",
    "src/modules/canvas/cli.ts",
    "src/modules/canvas/tools.test.ts",
    "src/modules/view/lofi.test.ts",
    "src/modules/systems/content/content.test.ts",
    "src/modules/systems/docs.test.ts",
    "src/platform/core/archive.test.ts",
    "src/platform/core/order.test.ts",
    "src/platform/core/modules/modules.test.ts",
    "src/platform/core/modules/globs.test.ts",
    "src/platform/core/permissions.test.ts",
    "src/platform/core/roots.test.ts",
    "src/platform/core/config.test.ts",
    "src/modules/systems/spec.test.ts",
    "src/platform/core/modules/pack.test.ts"
  ]
}
