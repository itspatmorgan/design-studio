      "height": 22.5,
      "id": "mustzxtka2hvi0",
      "index": "a1",
      "lineHeight": 1.25,
      "originalText": "Two ways to work with the same feedback flow. Keep the model portable, or turn it into a rough sketch.",
      "seed": 852094901,
      "text": "Two ways to work with the same feedback flow. Keep the model portable, or turn it into a rough sketch.",
