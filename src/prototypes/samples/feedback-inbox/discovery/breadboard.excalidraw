      "id": "mustzxtkcidxuv",
      "index": "a2",
      "lineHeight": 1.25,
      "originalText": "01  Reference the live diagram",
      "seed": 942094312,
      "text": "01 Reference the live diagram",
      "textAlign": "left",
      "type": "text",
      "version": 2,
      "versionNonce": 1386554639,
      "verticalAlign": "top",
      "width": 1000,
      "x": 40,
