{
  "schema": 1,
  "rules": [
    {
      "tier": "upstream",
      "paths": ["src/platform/**", "src/index.html", "src/lib/**", "src/types/**"],
      "note": "Shell, core APIs, platform context and skills."
    },
    {
      "tier": "upstream",
      "paths": [
        "src/modules/README.md",
        "src/modules/canvas/**",
        "src/modules/contributors/**",
        "src/modules/diagrams/**",
        "src/modules/document/**",
        "src/modules/documentation/**",
        "src/modules/onboarding/**",
        "src/modules/prototypes/**",
        "src/modules/systems/**",
        "src/modules/text/**",
        "src/modules/view/**"
      ],
      "note": "Supplied modules, listed by id. Required or optional."
    },
    {
      "tier": "team",
      "paths": ["src/modules/**"],
      "note": "The team's own modules. Less specific than the supplied ids above."
    },
    { "tier": "upstream", "paths": ["src/systems/studio/**"], "note": "Studio's own interface system." },
    {
      "tier": "seed",
      "paths": ["src/systems/product/**", "src/systems/marketing/**"],
      "note": "Example systems; adapt or replace them."
    },
    { "tier": "team", "paths": ["src/systems/**"], "note": "The team's other systems, including their package.json." },
    {
      "tier": "seed",
      "paths": ["src/prototypes/patrick/**", "contributors/patrick.json"],
      "note": "Sample prototypes and sample contributor."
    },
    {
      "tier": "team",
      "paths": ["src/prototypes/**", "contributors/**"],
      "note": "The team's prototypes and contributor profiles."
    },
    {
      "tier": "seed",
      "paths": ["studio.config.ts", "README.md"],
      "note": "The team's settings and README after creation."
    },
    {
      "tier": "upstream",
      "paths": ["scripts/**", "plugins/**", "patches/**", "public/**"],
      "note": "Tooling, setup, dependency patches, shared static files."
    },
    {
      "tier": "upstream",
      "paths": [
        "pnpm-workspace.yaml",
        "biome.json",
        "vite.config.ts",
        "tsconfig*.json",
        "mise.toml",
        ".github/**",
        ".husky/**"
      ],
      "note": "Root tooling and workflows."
    },
    {
      "tier": "upstream",
      "paths": [
        "CHANGELOG.md",
        "CONTRIBUTING.md",
        "SECURITY.md",
        "SETUP.md",
        "LICENSE",
        "CLAUDE.md",
        ".gitignore",
        ".claude-plugin/**",
        ".cursor-plugin/**",
        ".agents/plugins/**",
        ".studio/ownership.json"
      ],
      "note": "Project documents, plugin manifests, and this map."
    },
    { "tier": "generated", "paths": ["pnpm-lock.yaml"], "note": "pnpm install" },
    {
      "tier": "generated",
      "paths": [".agents/skills/**", ".claude/skills/**", ".agents/studio-skills.json"],
      "note": "pnpm studio sync. Team-authored adapter entries are kept."
    }
  ],
  "mixed": [
    {
      "paths": ["AGENTS.md"],
      "reason": "The module routing block is generated by pnpm studio sync; other lines are upstream guidance."
    },
    {
      "paths": ["package.json"],
      "reason": "Upstream tooling; a team module's dependencies are added to the root manifest."
    }
  ]
}
