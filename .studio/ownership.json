{
  "schema": 1,
  "rules": [
    {
      "tier": "upstream",
      "paths": ["src/platform/**", "src/index.html", "src/lib/**", "src/types/**"],
      "note": "Shell, core APIs, Node tooling, platform context and skills, Studio's own interface system (src/platform/systems/studio/), and the supplied modules (src/platform/modules/), required or optional."
    },
    {
      "tier": "team",
      "paths": ["src/modules/**"],
      "note": "The team's own modules (src/modules/)."
    },
    {
      "tier": "seed",
      "paths": ["src/systems/product/**", "src/systems/marketing/**"],
      "note": "Example systems; adapt or replace them."
    },
    {
      "tier": "team",
      "paths": ["src/systems/**"],
      "note": "The team's other systems, including their package.json."
    },
    {
      "tier": "seed",
      "paths": ["src/prototypes/patrick/**", "contributors/patrick.json"],
      "note": "Sample prototypes and sample contributor."
    },
    {
      "tier": "team",
      "paths": ["src/prototypes/**", "contributors/**"],
      "note": "The team's prototypes and contributor profiles."
    },
    {
      "tier": "seed",
      "paths": ["studio.config.json", "README.md", "AGENTS.team.md"],
      "note": "The team's settings, README, and agent guidance after creation."
    },
    {
      "tier": "upstream",
      "paths": ["patches/**", "public/**"],
      "note": "Dependency patches, shared static files."
    },
    {
      "tier": "upstream",
      "paths": [
        "pnpm-workspace.yaml",
        "biome.json",
        "vite.config.ts",
        "tsconfig*.json",
        "mise.toml",
        ".github/**",
        ".husky/**"
      ],
      "note": "Root tooling and workflows."
    },
    {
      "tier": "upstream",
      "paths": [
        "CHANGELOG.md",
        "CONTRIBUTING.md",
        "SECURITY.md",
        "LICENSE",
        "CLAUDE.md",
        ".gitignore",
        ".git-blame-ignore-revs",
        ".studio/ownership.json"
      ],
      "note": "Project documents, blame settings, and this map."
    },
    {
      "tier": "generated",
      "paths": ["pnpm-lock.yaml"],
      "note": "pnpm install"
    },
    {
      "tier": "generated",
      "paths": [".agents/skills/**", ".claude/skills/**", ".agents/studio-skills.json"],
      "note": "pnpm studio sync. Team-authored adapter entries are kept."
    },
    {
      "tier": "generated",
      "paths": ["AGENTS.md"],
      "note": "pnpm studio sync. Built from src/platform/AGENTS.md, the enabled modules, and AGENTS.team.md."
    }
  ],
  "mixed": [
    {
      "paths": ["package.json"],
      "reason": "Upstream tooling; a team module's dependencies are added to the root manifest."
    }
  ]
}
